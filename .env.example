# Copy to .env and fill in. NEVER commit .env.
# Every value below is a placeholder / name only — no real secret belongs in this file.

# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------
# OFFLINE_MODE=1 replays deterministic fixtures instead of calling any LLM.
# CI, `make test`, `make demo-offline` and `make smoke` all run with OFFLINE_MODE=1.
OFFLINE_MODE=1

# ---------------------------------------------------------------------------
# Model provider (ignored when OFFLINE_MODE=1)
# ---------------------------------------------------------------------------
# One of: anthropic | openai_compatible | bedrock
MODEL_PROVIDER=anthropic
MODEL_FAST=claude-haiku-4-5-20251001
MODEL_STRONG=claude-opus-5
MODEL_TEMPERATURE=0
MODEL_MAX_TOKENS=2048

# anthropic
ANTHROPIC_API_KEY=

# openai_compatible (OpenAI, Together, vLLM, ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# bedrock — credentials come from the standard AWS chain
AWS_REGION=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Admin/seed connection (used by db/seed.py only).
DATABASE_URL=
# Read-only connection used by execute_sql. Points at the t2sql_ro role.
# Local dev pattern: ssh -L 5432:localhost:5432 user@vps , then use localhost here.
DATABASE_URL_RO=

# ---------------------------------------------------------------------------
# Agent bounds
# ---------------------------------------------------------------------------
MAX_ITERATIONS=6
MAX_ROWS=1000
STATEMENT_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Observability (optional — Postgres agent_traces is always the source of truth)
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ---------------------------------------------------------------------------
# Deployment (set on the VPS only, never committed)
# ---------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=
API_PORT=8000
UI_PORT=8501
